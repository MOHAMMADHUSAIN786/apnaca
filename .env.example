# Copy to `.env` and fill with real values. NEVER commit `.env`.
#
# ⚠️ TRANSITIONAL: these keys currently ship inside the app bundle, which is
# insecure. They must move behind the agent gateway (server-side) — see the
# architecture audit. Until then, keep `.env` out of git and rotate keys if
# they are ever exposed.

# OpenRouter API key — used by lib/features/ai_chat/service/openrouter_service.dart
OPENROUTER_KEY=

# Razorpay TEST keys — used by lib/features/subscription/presentation/pages/subscription_screen.dart
# The SECRET key must NOT be in the client. Remove it from the app once the
# server creates orders + verifies the payment signature.
TEST_RAZORPAY_API_KEY=
TEST_RAZORPAY_SECRET_KEY=

# ── Agent Gateway (Phase 2) ──────────────────────────────────────────────────
# When both are set, the AI chat routes through the server (server/) instead of
# calling OpenRouter directly from the app. Leave blank to keep the local path.
AGENT_GATEWAY_URL=
AGENT_GATEWAY_ENABLED=false
