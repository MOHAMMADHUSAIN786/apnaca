# Copy to server/.env for local dev. In production use Secret Manager, not a file.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# ── LLM ────────────────────────────────────────────────────────────────────────
# The key that used to live in the Flutter app bundle. It lives ONLY here now.
OPENROUTER_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_FAST=google/gemini-2.5-flash
LLM_MODEL_STANDARD=google/gemini-2.5-flash
LLM_MODEL_ADVANCED=anthropic/claude-sonnet-4
MAX_AGENT_STEPS=5

# ── Firebase (token verification) ─────────────────────────────────────────────
# Service account JSON. Local: path to the file. Cloud Run: mount as a secret
# or rely on Application Default Credentials and set only the project id.
FIREBASE_PROJECT_ID=apnaca-5098e
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://apnaca:apnaca@localhost:5432/apnaca_agent

# ── Razorpay (server-only — the SECRET must never reach the app) ──────────────
# Billing routes are disabled until all three are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay dashboard → Settings → Webhooks. Subscribe to
# `payment.captured` and `order.paid`, endpoint: <gateway>/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. The mobile app itself needs no origin; this is for local
# web tooling / the emulator.
CORS_ORIGINS=http://localhost:3000
